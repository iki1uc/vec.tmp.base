# Niemals echte Zugangsdaten in GitHub einchecken.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-session-secret

# Discord OAuth: Die Redirect-URL muss exakt im Discord Developer Portal eingetragen sein.
DISCORD_CLIENT_ID=replace-with-your-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-your-discord-application-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Bot und Discord-Server, dessen aktuelle Mitgliedschaft den Zugang erlaubt.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_GUILD_ID=replace-with-your-discord-server-id
