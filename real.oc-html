<span class="it">CPU <b id="sCPU">—</b></span>
<span class="it">Cycles <b id="sCycles">0</b></span>
<span class="it">PC <b id="sPC">0x00</b></span>
<span class="it">OUT <b id="sOUT">0</b></span>
<span class="it">Uptime <b id="sUp">0s</b></span>
<span class="it">KAISER <b id="sKaiser" style="color:#ffd700">55</b></span>
<span class="it">DRACHE <b id="sDrache" style="color:#ff4a2e">OST</b></span>
<span class="it">9=<b>EVIG</b> 99=<b>EDIT TOR HH.tor</b> 999=<b>NUTZ BENCH born.t</b></span>
<span class="it">PQ=<b>nur PQ weil er das auch ist 2t höchste</b></span>
</div>
<div class="boot" id="boot"></div>
<main>
<section class="panel" style="border-color:#ffd700">
<h3><span><span class="id">44+55</span> GPU+PC = DRACHE+KAISER = REAL.PC FUSION — HOLO.engine.js + HOLO.room.js</span><span class="led kaiser on" id="ledGPU"></span></h3>
<canvas id="gpuCanvas"></canvas>
<div class="drachehud" id="dracheModes"></div>
<div class="kaiserbar" id="kaiserModes"></div>
<div class="row"><span class="lbl">Gear 22</span><span class="val grn" id="gearRPM">0 RPM</span><span class="lbl" style="margin-left:auto">Buffer</span><span class="val" id="bufN">0</span><span class="lbl">KaiserPower</span><span class="val" id="kPower" style="color:#ffd700">0%</span><span class="lbl">Rauch</span><input id="rauch" type="range" min="0" max="100" value="20" style="width:60px"><span id="rauchLbl">20%</span></div>
<div style="display:flex;gap:4px"><div class="bar"><div class="fill" id="barKaiser" style="background:var(--gold);width:0%"></div></div><div class="bar"><div class="fill" id="barDrache" style="background:var(--red);width:0%"></div></div><div class="bar"><div class="fill" id="barFusion" style="background:var(--grn);width:0%"></div></div></div>
</section>
<section class="panel">
<h3><span><span class="id">77+55</span> CPU+KAISER · CALC-128X · 55=KAISER herrscht über 11-99</span><span class="led on" id="ledCPU"></span></h3>
<div class="regs">
<div class="reg"><div class="n">A KAISER</div><div class="v" id="regA">0x00</div></div>
<div class="reg"><div class="n">B DRACHE</div><div class="v" id="regB">0x00</div></div>
<div class="reg"><div class="n">C PQ</div><div class="v" id="regC">0x00</div></div>
<div class="reg"><div class="n">D HOME</div><div class="v" id="regD">0x00</div></div>
<div class="reg"><div class="n">PC</div><div class="v" id="regPC">0x00</div></div>
<div class="reg"><div class="n">IR</div><div class="v" id="regIR">0x00</div></div>
<div class="reg"><div class="n">SP</div><div class="v" id="regSP">0xFF</div></div>
<div class="reg"><div class="n">FLAGS 9=EVIG</div><div class="v" id="regF">0x00</div></div>
</div>
<div class="row" style="margin-top:6px"><span class="lbl">Next</span><span class="val grn" id="nextInstr">—</span></div>
<div class="row"><span class="lbl">Instr</span><span class="val">LOAD KAISER STORE KAISER ADD DRACHE JMP EVIG JZ SUB HLT OUT FUSION=KAISER+DRACHE</span></div>
<div class="row"><span class="lbl">1MB</span><span class="val">1024 REAL — d.hdf.rom e.hdf.rom i.hdf.rom n.hdf.rom o.hdf.rom r.hdf.rom s.hdf.rom u.hdf.rom w.hdf.rom</span></div>
</section>
<section class="panel">
