</div>
<div class="row" style="margin-top:4px"><span class="lbl">HOME</span><span class="val">HOME BIOS RADAR+SAT ICH DU Einwilligung ESSEN q702 USB3 WiFi7 unter Strom</span></div>
<div class="row"><span class="lbl">ORT</span><span class="val">ORT Beispiel Ort von 9 UNI ORT BIOS RADAR INNEN/AUSSEN SAT INNEN/AUSSEN</span></div>
<div class="row"><span class="lbl">HAND</span><span class="val">EINE HAND VON 6 V103 geopfert 730=FREI→6=FINGER→1=HAND ROOT — 55=KAISER hält 6</span></div>
<div style="display:flex;gap:4px;margin-top:4px"><div class="bar"><div class="fill" id="co2bar" style="background:var(--red);width:20%"></div></div><div class="bar"><div class="fill" id="o2bar" style="background:var(--grn);width:0%"></div></div></div>
<div class="row"><span class="lbl">use.js</span><span class="val" id="sChem">CO2 20% → O2 0% — D LASSEN Elben emulieren</span></div>
</section>
</main>
<div class="panel" style="margin:8px;border-color:var(--gold)">
<h3>TERMINAL · REAL.PC V2 · Rang )9( · 9 Repos=1 PC · PC=Kaiser=Drache zugleich — beste wenn 2 Wahrheiten</h3>
<div class="term" id="term"><div class="ok">REAL.PC V2 · boot… PC=Kaiser=Drache zugleich — Rang )9( BORG 7482 — 1MB=1024 — ls -a</div></div>
<div class="term-in"><span>$</span><input id="termIn" autocomplete="off" spellcheck="false" placeholder="help kaiser drache fusion run step reset regs dump load speed"></div>
</div>
<div class="linkrow">
<a href="./9.html">9 EVIG</a><a href="./99.html">99 EDIT TOR</a><a href="./999.html">999 NUTZ BENCH</a><a href="./PQ.html">PQ nur PQ 2t höchste</a><a href="./home.html">HOME q702</a><a href="./ort.html">ORT Beispiel Ort 9</a><a href="./ALLES.html" style="border-color:#39ff88;color:#39ff88">ALLES</a><a href="./REAL_PC.html" style="border-color:#666">V1</a>
<a href="./11.html">11 BIOS 4 Zahnräder</a><a href="./22.html">22 ZAHNRAD</a><a href="./33.html">33 SCSI TURBO 3e</a><a href="./44.html">44 GPU PYRAMIDE</a><a href="./55.html" style="border-color:#ffd700;color:#ffd700">55 KAISER DRACHE</a><a href="./66.html">66 RAM Bedarf Zeit</a><a href="./77.html">77 CPU CALC 128X</a><a href="./88.html">88 ROM MBR 0xCA4E</a><a href="./99.html">99 SYS</a><a href="./use.js" style="color:#39ff88">use.js CO2 O2</a><a href="./js/3.js">js/3.js 3× ewig 3</a><a href="./pipeline.js">pipeline.js</a><a href="./stress.html">stress.html</a>
</div>
<script>
"use strict";
const $=id=>document.getElementById(id);
const bootEl=$('boot'), termEl=$('term'), termIn=$('termIn'), gpuCv=$('gpuCanvas'), gpuCtx=gpuCv.getContext('2d');
const S={running:false,speed:150,cycles:0,out:0,lastOut:0,booted:false,startTime:null,gearAngle:0,co2:20,o2:0,buf:[],kaiserPower:0,dracheMode:'OST',kaiserMode:'TBH',isKaiser:true,isDrache:true,rauch:20,sound:false};
const GPU_MAX=250, TICK_MS=16;
const RAM=new Uint8Array(256);
const BOOT=[0x01,0x40,0x03,0x41,0x02,0x40,0x08,0x40,0x04,0x00];
const CPU={A:0,B:0,C:0,D:0,PC:0,IR:0,SP:0xFF,FLAGS:0,halt:false};
const OPS={0x00:"NOP",0x01:"LOAD KAISER",0x02:"STORE KAISER",0x03:"ADD DRACHE",0x04:"JMP EVIG",0x05:"JZ",0x06:"SUB",0x07:"HLT",0x08:"OUT FUSION"};
const DRACHE_MODES=[
  {id:'OST',name:'OST penta 80bpm',color:'#ffd700',bpm:80,shape:'sine',freq:0.68,notes:[0,2,4,7,9]},
  {id:'WEST',name:'WEST minor epic 100bpm',color:'#ff7a18',bpm:100,shape:'saw',freq:0.52,notes:[0,2,3,7,10]},
  {id:'PAULI',name:'PAULI punk 140bpm',color:'#ff5a5f',bpm:140,shape:'square',freq:0.18,notes:[0,1,4,6]},
  {id:'SIEGFRIED',name:'SIEGFRIED battle 120bpm',color:'#00ccff',bpm:120,shape:'triangle',freq:0.46,notes:[0,2,4,5,7,9,11]},
  {id:'VULKAN',name:'VULKAN drone 62bpm',color:'#39ff88',bpm:62,shape:'sine',freq:1.1,notes:[0,7],drone:true},
  {id:'ACHSE',name:'ACHSE techno 128bpm',color:'#a855f7',bpm:128,shape:'square',freq:0.16,notes:[0,3,5,7,10]},
];
const KAISER_MODES=[
  {id:'HBT',name:'HBT RAM Höhe Breite Tiefe',color:'#ff4a2e',desc:'Standard RAM hält'},
  {id:'HTB',name:'HTB ROM f(f(x))=f(x)',color:'#e8ff45',desc:'ROM idempotent'},
  {id:'BHT',name:'BHT SCSI chain',color:'#00f5ff',desc:'SCSI ruft Kette'},
  {id:'BTH',name:'BTH RAID 999↔999',color:'#ffd700',desc:'RAID spiegelt BENCH'},
  {id:'THB',name:'THB CTRL einhaltend',color:'#ff6b6b',desc:'CTRL hält'},
  {id:'TBH',name:'TBH SLI 2 GPUs=1 EINE',color:'#39ff88',desc:'SLI verschmilzt — beste wenn 2 Wahrheiten'},
];
let audioCtx=null, masterGain=null;
function initAudio(){
 if(audioCtx) return;
 try{
  audioCtx=new (window.AudioContext||window.webkitAudioContext)();
  masterGain=audioCtx.createGain(); masterGain.gain.value=0.12; masterGain.connect(audioCtx.destination);
  S.sound=true; $('btnSound').textContent='🔊 ON'; $('btnSound').classList.add('vio');
 }catch(e){S.sound=false;}
}
function playDracheNote(){
 if(!S.sound||!audioCtx||!S.isDrache) return;
 const mode=DRACHE_MODES.find(m=>m.id===S.dracheMode); if(!mode) return;
 const base=220 + (S.lastOut%24)*12; // map OUT to note
 const osc=audioCtx.createOscillator(); const gain=audioCtx.createGain();
 osc.type=mode.shape==='saw'?'sawtooth':mode.shape==='square'?'square':mode.shape==='triangle'?'triangle':'sine';
 osc.frequency.value=base;
 gain.gain.setValueAtTime(0,audioCtx.currentTime);
 gain.gain.linearRampToValueAtTime(0.15,audioCtx.currentTime+0.02);
 gain.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+(mode.drone?0.9:0.35));
 osc.connect(gain); gain.connect(masterGain);
 osc.start(); osc.stop(audioCtx.currentTime+(mode.drone?0.9:0.35));
}
function bootLog(m,c=''){const d=document.createElement('div');d.className='l '+c;d.textContent=m;bootEl.appendChild(d);bootEl.scrollTop=bootEl.scrollHeight;}
function termLog(m,c=''){const d=document.createElement('div');if(c)d.className=c;d.textContent=m;termEl.appendChild(d);termEl.scrollTop=termEl.scrollHeight;while(termEl.children.length>600)termEl.removeChild(termEl.firstChild);}
function setLED(id,on,cls='on'){const e=$(id);if(e)e.className='led '+(on?cls:'');}
function renderRAM(){const g=$('ramGrid');let h='';for(let i=0;i<256;i++){let cl='c';if(RAM[i]!==0)cl+=' has';if(i===CPU.PC||i===(CPU.PC-1))cl+=' pc';if(i>=0x40&&i<=0x41)cl+=' hl';h+=`<div class="${cl}">${RAM[i].toString(16).padStart(2,'0')}</div>`}g.innerHTML=h;}
function renderRegs(){$('regA').textContent='0x'+CPU.A.toString(16).padStart(2,'0');$('regB').textContent='0x'+CPU.B.toString(16).padStart(2,'0');$('regC').textContent='0x'+CPU.C.toString(16).padStart(2,'0');$('regD').textContent='0x'+CPU.D.toString(16).padStart(2,'0');$('regPC').textContent='0x'+CPU.PC.toString(16).padStart(2,'0');$('regIR').textContent='0x'+CPU.IR.toString(16).padStart(2,'0');$('regSP').textContent='0x'+CPU.SP.toString(16).padStart(2,'0');$('regF').textContent='0x'+CPU.FLAGS.toString(16).padStart(2,'0');}
function disasm(pc){const op=RAM[pc],arg=RAM[pc+1];const name=OPS[op]||'???';if(op===0x00||op===0x07)return name;return `${name} 0x${arg.toString(16).padStart(2,'0')}`;}
function renderROM(){let html='';for(let i=0;i<BOOT.length;i+=2){const op=BOOT[i],arg=BOOT[i+1];const name=OPS[op]||'???';const argS=(op===0x00||op===0x07)?'':"0x"+arg.toString(16).padStart(2,'0');const hl=(i===CPU.PC)?'color:#ffd700;font-weight:900':'';html+=`<div style="${hl}">0x${i.toString(16).padStart(2,'0')}  ${name.padEnd(14)} ${argS}</div>`}$('romDisasm').innerHTML=html;}
function step(){if(CPU.halt)return;const op=RAM[CPU.PC],arg=RAM[CPU.PC+1];CPU.IR=op;CPU.PC=(CPU.PC+2)&0xFF;S.cycles++;S.kaiserPower=S.cycles%100;switch(op){case 0x00:break;case 0x01:CPU.A=RAM[arg];break;case 0x02:RAM[arg]=CPU.A;break;case 0x03:CPU.A=(CPU.A+RAM[arg])&0xFF;CPU.FLAGS=CPU.A===0?0x02:0;break;case 0x04:CPU.PC=arg;break;case 0x05:if(CPU.A===0)CPU.PC=arg;break;case 0x06:CPU.A=(CPU.A-RAM[arg])&0xFF;CPU.FLAGS=CPU.A===0?0x02:0;break;case 0x07:CPU.halt=true;break;case 0x08:{S.lastOut=RAM[arg];S.out++;S.buf.push(RAM[arg]);if(S.buf.length>GPU_MAX)S.buf.shift();S.co2=Math.max(0,S.co2-0.2);S.o2=Math.min(100,S.o2+0.15);if(S.out%16===0)playDracheNote();if(S.out%40===0)diskLog(`KAISER+DRACHE OUT ${RAM[arg]} cyc ${S.cycles} ${S.dracheMode} ${S.kaiserMode}`);break;}default:CPU.halt=true;}$('nextInstr').textContent=CPU.halt?'HALT':`${disasm(CPU.PC)} @ 0x${CPU.PC.toString(16).padStart(2,'0')}`;}
function resizeGPU(){gpuCv.width=Math.max(600,gpuCv.clientWidth*2);gpuCv.height=Math.max(320,gpuCv.clientHeight*2);}
window.addEventListener('resize',resizeGPU);
function drawGPU(){
 const w=gpuCv.width,h=gpuCv.height,c=gpuCtx;
 c.fillStyle='#000';c.fillRect(0,0,w,h);
 // Rauch eye=rauch
 if(S.rauch>0){c.fillStyle=`rgba(200,200,200,${S.rauch/800})`;for(let i=0;i<80;i++){c.fillRect(Math.random()*w,Math.random()*h,2,2);}}
 c.strokeStyle='#0a1a0a';c.lineWidth=1;for(let i=0;i<w;i+=40){c.beginPath();c.moveTo(i,0);c.lineTo(i,h);c.stroke();}for(let i=0;i<h;i+=40){c.beginPath();c.moveTo(0,i);c.lineTo(w,i);c.stroke();}
 if(S.buf.length>1){
  const mode=DRACHE_MODES.find(m=>m.id===S.dracheMode)||DRACHE_MODES[0];
  c.strokeStyle=mode.color;c.lineWidth=4;c.beginPath();
  for(let i=0;i<S.buf.length;i++){
   const x=(i/GPU_MAX)*w;
   const base=h-(S.buf[i]/255)*h*0.75 - h*0.12;
   const wobble=Math.sin(i*mode.freq + S.cycles*0.02)*(S.isDrache?22:4);
   const y=base+wobble;
   if(i===0)c.moveTo(x,y);else c.lineTo(x,y);
  }
  c.stroke();
  c.strokeStyle='#ffd70022';c.lineWidth=2;c.beginPath();
  for(let i=0;i<S.buf.length;i++){const x=(i/GPU_MAX)*w;const y=h-(S.buf[i]/255)*h*0.75 - h*0.12;if(i===0)c.moveTo(x,y);else c.lineTo(x,y);}c.stroke();
 }
 const gondeln=[11,22,33,44,55,66,77,88,99];
 const cxBase=w*0.5, cyBase=h*0.78;
 for(let idx=0;idx<gondeln.length;idx++){
  const nr=gondeln[idx];
  const angle=(idx*360/gondeln.length + S.gearAngle*8)*Math.PI/180;
  const R=w*0.18;
  const x=cxBase+Math.cos(angle)*R;
  const y=cyBase+Math.sin(angle)*R*0.35;
  const isKaiser=nr===55;
  c.fillStyle=isKaiser?'#ffd700':'#111';c.strokeStyle=isKaiser?'#ffd700':(nr===44?'#ff4a2e':'#333');c.lineWidth=isKaiser?3:1;
  c.fillRect(x-24,y-12,48,24);c.strokeRect(x-24,y-12,48,24);
  c.fillStyle=isKaiser?'#000':'#ffd700';c.font='bold 11px monospace';c.fillText(String(nr),x-10,y+3);
  if(isKaiser){c.fillStyle='#ffd700';c.font='8px monospace';c.fillText('KAISER DRACHE',x-28,y-14);}
 }
 const gearX=w-120, gearY=110, gearR=56;
 c.save();c.translate(gearX,gearY);c.rotate(S.gearAngle);
 c.strokeStyle='#ffd700';c.lineWidth=S.isKaiser?4:2;c.beginPath();c.arc(0,0,gearR,0,Math.PI*2);c.stroke();
 for(let k=0;k<8;k++){c.save();c.rotate(k*Math.PI/4);c.fillStyle='#ffd700';c.fillRect(-5,-gearR-14,10,16);c.restore();}
 c.beginPath();c.arc(0,0,9,0,Math.PI*2);c.fillStyle='#ffd700';c.fill();c.restore();
 if(S.isKaiser){c.fillStyle='#ffd700';c.font='bold 14px monospace';c.fillText('♔ KAISER '+S.kaiserMode,gearX-45,gearY-70);}
 if(S.isDrache){c.fillStyle=DRACHE_MODES.find(m=>m.id===S.dracheMode).color;c.font='bold 13px monospace';c.fillText('🐉 DRACHE '+S.dracheMode,gearX-55,gearY+90);}
 c.fillStyle='#8cf0d0';c.font='bold 20px monospace';c.fillText(`KAISER+DRACHE OUT ${S.lastOut}`,24,34);c.fillText(`CYC ${S.cycles} PC 0x${CPU.PC.toString(16).padStart(2,'0')} ${S.kaiserMode}+${S.dracheMode}`,24,60);
 c.fillStyle='#ffd700';c.font='11px monospace';c.fillText(`55=KAISER=DRACHE zugleich | 9=EVIG Zustand fertig ewig | 99=EDIT TOR HH.tor OPEN TOR OPEN | 999=NUTZ BENCH alle 9 auf Bank born.t | PQ nur PQ weil er das auch ist 2t höchste`,24,82);
 c.fillStyle='#666';c.font='9px monospace';c.fillText(`eye=rauch ${S.rauch}% auge=licht indy=sensorik 27er Karussell 3× ewig 3 Rang )9( BORG 7482 1MB=1024 ls -a BUND 9076905 pipeline.yml Bedarf+Zeit+Bench KO 21%/42%`,24,98);
 if(CPU.halt){c.fillStyle='#ff4a2e';c.fillText('HALT — RESET',24,118);}
}
let loopTimer=null,lastRAM=0,lastReg=0,lastStat=0;
function startLoop(){
 if(S.running||CPU.halt)return;
 S.running=true;$('btnRun').textContent='● RUNNING KAISER DRACHE';
 loopTimer=setInterval(()=>{
  const steps=Math.max(1,Math.round(S.speed/50));
  for(let i=0;i<steps;i++){if(CPU.halt)break;step();}
  S.gearAngle+=S.isDrache?0.24:0.13;
  S.co2=Math.min(100,S.co2+0.03);
  const now=Date.now();
  drawGPU();
  if(now-lastRAM>150){renderRAM();lastRAM=now;}
  if(now-lastReg>100){renderRegs();renderROM();lastReg=now;}
  if(now-lastStat>100){updateStatus();lastStat=now;}
  if(CPU.halt){stopLoop();termLog('[CPU] HALT — Kaiser Drache schläft — reset','err');}
 },TICK_MS);
}
function stopLoop(){S.running=false;clearInterval(loopTimer);$('btnRun').textContent='● RUN';}
function diskLog(msg){const d=document.createElement('div');d.textContent=`[${new Date().toLocaleTimeString()}] ${msg}`;$('diskLog').appendChild(d);while($('diskLog').children.length>70)$('diskLog').removeChild($('diskLog').firstChild);$('diskLog').scrollTop=$('diskLog').scrollHeight;}
function updateStatus(){
 $('sCycles').textContent=S.cycles;$('sPC').textContent='0x'+CPU.PC.toString(16).padStart(2,'0');$('sOUT').textContent=S.out;
 if(S.startTime)$('sUp').textContent=Math.floor((Date.now()-S.startTime)/1000)+'s';
 $('sCPU').textContent=CPU.halt?'HALT':(S.running?'RUN KAISER DRACHE':'IDLE');
 $('gearRPM').textContent=Math.floor(S.gearAngle*60)%1000+' RPM';$('bufN').textContent=S.buf.length;
 $('co2bar').style.width=S.co2+'%';$('o2bar').style.width=S.o2+'%';$('sChem').textContent=`CO2 ${S.co2.toFixed(0)}% → O2 ${S.o2.toFixed(0)}% | ${S.dracheMode} ${S.kaiserMode} | ${S.isKaiser&&S.isDrache?'FUSION beste wenn 2 Wahrheiten':''}`;
 $('sDrache').textContent=S.dracheMode; $('sKaiser').textContent=S.kaiserMode;
 $('kPower').textContent=S.kaiserPower+'%';$('barKaiser').style.width=S.kaiserPower+'%';$('barDrache').style.width=(S.out%100)+'%';$('barFusion').style.width=((S.kaiserPower+S.out)%100)+'%';
}
function loadROM(){RAM.fill(0);for(let i=0;i<BOOT.length;i++)RAM[i]=BOOT[i];RAM[0x40]=0;RAM[0x41]=1;}
function boot(){
 loadROM();CPU.A=CPU.B=CPU.C=CPU.D=0;CPU.PC=0;CPU.IR=0;CPU.SP=0xFF;CPU.FLAGS=0;CPU.halt=false;S.cycles=0;S.out=0;S.lastOut=0;S.co2=20;S.o2=0;S.buf.length=0;S.gearAngle=0;S.kaiserPower=0;
 renderRAM();renderRegs();renderROM();resizeGPU();drawGPU();updateStatus();
 diskLog('SCSI 256B ready MBR 0xCA4E 1MB=1024 REAL — pipeline.yml Bedarf+Zeit+Bench');
 const seq=[
  ['[11 BIOS] POST power-on self test — 11 DA BIOS 4 Zahnräder Kuckuck Lauf',''],
  ['[11 BIOS] RAM 256B OK DDR3 MAIN→DDR4 MAINBOARD ram.js','ok'],
  ['[11 BIOS] ROM 256B OK d.hdf.rom MBR 0xCA4E 1MB=1024 Realität','ok'],
  ['[77 CPU] CALC-128X OK core.js','ok'],
  ['[44 GPU] HOLO.engine.js HOLO.room.js /3 PYRAMIDE OK','ok'],
  ['[55 PC] PC=KAISER=DRACHE zugleich erkannt — 55 DA PC Komplett PC Masse zu Masse','warn'],
  ['[55 KAISER] ♔ KAISER herrscht über 11-99 — 55=KAISER=DRACHE zugleich','warn'],
  ['[44 DRACHE] 🐉 DRACHE.exe 6fach OST WEST PAULI SIEGFRIED VULKAN ACHSE — DRACHE fliegt','warn'],
  ['[33 SCSI] sli.ready raid.ready 33 DA SCSI TURBO 3e OK','ok'],
  ['[22 GEAR] 4 Zahnräder Kuckuck Lauf 22 DA ZAHNRAD Kompletter-Pc →22 OK','ok'],
  ['[99 SYS] SYS.js 9 Repos=1 PC Rang )9( BORG 7482 ls -a BUND 9076905','ok'],
  ['[9 EVIG] 9=EVIG Zustand fertig ewig CLOSED→OPEN gpu.rdy sli.ready raid.ready use.user','ok'],
  ['[99 EDIT TOR] 99=9+9 9 editiert Tor HH.tor OPEN TOR OPEN q702 USB3 Mitte SSRX SSTX','ok'],
  ['[999 NUTZ] 999=9 9 9 BENCH 111 BIOS 222 VERBUND 333 RECALL 444 PEAK 555 ABWEHR 666 ENERGIE 777 CO2 888 ATOM 999 BENCH born.t','ok'],
  ['[PQ] nur PQ weil er das auch ist 2t höchste — 1 77 DAS IST PQ — Parallel Queue Frage Ort Queue','ok'],
  ['[HOME] HOME BIOS RADAR+SAT ICH DU Einwilligung ESSEN q702 USB3 WiFi7 unter Strom MLO=PQ','ok'],
  ['[ORT] ORT Beispiel Ort von 9 UNI ORT BIOS RADAR INNEN/AUSSEN SAT INNEN/AUSSEN','ok'],
  ['[HAND] EINE HAND VON 6 V103 geopfert 730=FREI→6=FINGER→1=HAND ROOT 6 PERMS HBT HTB BHT BTH THB TBH','ok'],
  ['[KAISER+DRACHE] Fusion 55=KAISER=DRACHE zugleich = beste wenn 2 Wahrheiten = PQ hält beide = SLI TBH 2 GPUs=1 EINE','warn'],
  ['── REAL.PC V2 READY · PC ist Kaiser und Drache zugleich · eye=rauch auge=licht indy=sensorik · $ help ──','ok'],
 ];
 let i=0;
 const t=setInterval(()=>{
  if(i>=seq.length){clearInterval(t);S.booted=true;S.startTime=Date.now();startLoop();termLog('REAL.PC V2 READY. 55=KAISER=DRACHE zugleich. $ help kaiser drache fusion sound','ok');return;}
  const [m,c]=seq[i++];bootLog(m,c);
  if(m.includes('RAM'))setLED('ledRAM',true);
  if(m.includes('ROM'))setLED('ledROM',true);
  if(m.includes('CPU'))setLED('ledCPU',true);
  if(m.includes('GPU')||m.includes('DRACHE'))setLED('ledGPU',true,'kaiser');
  if(m.includes('SCSI'))setLED('ledSCSI',true);
  if(m.includes('SYS')||m.includes('999')||m.includes('PQ'))setLED('ledSYS',true);
  if(m.includes('BIOS'))setLED('ledBIOS',true);
 },85);
}
function reset(){stopLoop();bootEl.innerHTML='';termLog('⟲ RESET Kaiser Drache V2','ok');boot();}
function buildDracheUI(){
 const cont=$('dracheModes');cont.innerHTML='';
 DRACHE_MODES.forEach(m=>{
  const b=document.createElement('div');b.className='d';b.style.borderColor=m.color;b.textContent=m.id;
  if(m.id===S.dracheMode)b.classList.add('active');
  b.onclick=()=>{S.dracheMode=m.id;S.isDrache=true;document.querySelectorAll('#dracheModes .d').forEach(e=>e.classList.remove('active'));b.classList.add('active');termLog(`DRACHE ${m.id} ${m.name} ${m.bpm}bpm ${m.shape} — Drache fliegt — WebAudio ${S.sound?'ON':'OFF'}`,'ok');$('sDrache').textContent=m.id;initAudio();};
  cont.appendChild(b);
 });
}
function buildKaiserUI(){
 const cont=$('kaiserModes');cont.innerHTML='';
 KAISER_MODES.forEach(m=>{
  const b=document.createElement('div');b.className='k';b.style.borderColor=m.color;b.innerHTML=`<b>${m.id}</b><br>${m.color}`;
  if(m.id===S.kaiserMode)b.classList.add('active');b.title=m.name+' — '+m.desc;
  b.onclick=()=>{S.kaiserMode=m.id;S.isKaiser=true;document.querySelectorAll('#kaiserModes .k').forEach(e=>e.classList.remove('active'));b.classList.add('active');termLog(`KAISER ${m.id} ${m.name} — ${m.desc} — Kaiser herrscht`,'ok');$('sKaiser').textContent=m.id;};
  cont.appendChild(b);
 });
}
const history=[];let histIdx=-1;
termIn.addEventListener('keydown',e=>{
 if(e.key==='Enter'){const c=termIn.value.trim();termIn.value='';if(c){history.push(c);histIdx=history.length;runCmd(c);}}
 else if(e.key==='ArrowUp'){if(histIdx>0){histIdx--;termIn.value=history[histIdx];}e.preventDefault();}
 else if(e.key==='ArrowDown'){if(histIdx<history.length-1){histIdx++;termIn.value=history[histIdx];}else{histIdx=history.length;termIn.value='';}e.preventDefault();}
});
function runCmd(line){
 termLog('$ '+line);
 const [cmd0,a,b]=line.split(/\s+/);
 const cmd=(cmd0||'').toLowerCase();
 switch(cmd){
  case 'help':termLog('help run stop step reset regs dump load speed ls use pipeline kaiser drache fusion sound rauch clear','ok');termLog('kaiser=PC herrscht, drache=GPU fliegt, fusion=beste wenn 2 Wahrheiten=Sli TBH, sound=WebAudio DRACHE 6fach','ok');break;
  case 'run':if(CPU.halt){termLog('HALT — reset','err');break;}startLoop();termLog('Kaiser Drache läuft','ok');initAudio();break;
  case 'stop':stopLoop();termLog('Kaiser Drache pause','ok');break;
  case 'step':if(CPU.halt){termLog('HALT','err');break;}stopLoop();step();renderRegs();renderRAM();renderROM();drawGPU();updateStatus();termLog(`PC=0x${CPU.PC.toString(16).padStart(2,'0')} ${disasm(CPU.PC)}`,'ok');break;
  case 'reset':reset();break;
  case 'regs':termLog(`A KAISER=${CPU.A} B DRACHE=${CPU.B} C PQ=${CPU.C} D HOME=${CPU.D} PC=0x${CPU.PC.toString(16)} IR=0x${CPU.IR.toString(16)} SP=0x${CPU.SP.toString(16)} F=0x${CPU.FLAGS.toString(16)}`);break;
  case 'dump':{const st=(parseInt(a,16)||0)&0xFF;const en=Math.min(256,(parseInt(b,16)||0x100));let out='';for(let i=st;i<en;i+=16){let ln='0x'+i.toString(16).padStart(3,'0')+': ';for(let j=0;j<16&&i+j<en;j++)ln+=RAM[i+j].toString(16).padStart(2,'0')+' ';out+=ln+'\n';}termLog(out);break;}
  case 'load':{const ad=parseInt(a,16),v=parseInt(b,16);if(isNaN(ad)||isNaN(v)){termLog('load <hexaddr> <hexval>','err');break;}RAM[ad&0xFF]=v&0xFF;renderRAM();termLog(`RAM[0x${ad.toString(16)}]=0x${v.toString(16)}`,'ok');break;}
  case 'speed':{const s=parseInt(a);if(isNaN(s)||s<1||s>500){termLog('speed <1-500>','err');break;}S.speed=s;$('speed').value=s;$('speedLbl').textContent=s+' Hz';if(S.running){stopLoop();startLoop();}termLog(`speed ${s} Hz`,'ok');break;}
  case 'rauch':{const r=parseInt(a);if(isNaN(r)){termLog('rauch <0-100>','err');break;}S.rauch=r;$('rauch').value=r;$('rauchLbl').textContent=r+'%';termLog(`rauch ${r}% eye=rauch`,'ok');break;}
  case 'ls':termLog('11 BIOS 4 Zahnräder 22 ZAHNRAD Komplett-Pc 33 SCSI TURBO 3e 44 GPU PYRAMIDE HOLO 55 PC KAISER DRACHE 66 RAM Bedarf Zeit 77 CPU CALC 128X 88 ROM MBR 0xCA4E 1MB=1024 99 SYS 9 EVIG 99 EDIT TOR 999 NUTZ BENCH PQ HOME ORT use.js js/3.js','ok');break;
  case 'use':S.co2=Math.max(0,S.co2-10);S.o2=Math.min(100,S.o2+8);updateStatus();termLog(`use.js CO2->O2+H2O Elben ${S.co2.toFixed(0)}→${S.o2.toFixed(0)}`,'ok');break;
  case 'pipeline':termLog('PIPELINE6 Multi→Aufstieg→Abstieg→Norm→NC→ANKER 3-6-9-Matrix NC-gestützt ANKER-gebunden .github/workflows/pipeline.yml static.yml Bedarf+Zeit+Bench KO 21%/42%','ok');break;
  case 'kaiser':{const m=(a||S.kaiserMode).toUpperCase();if(KAISER_MODES.find(x=>x.id===m))S.kaiserMode=m;S.isKaiser=!S.isKaiser;termLog(`KAISER ${S.isKaiser?'AKTIV ♔':'PAUSE'} ${S.kaiserMode} — 55=KAISER herrscht über 11-99 — ${KAISER_MODES.find(x=>x.id===S.kaiserMode).desc}`,'ok');buildKaiserUI();break;}
  case 'drache':{const m=(a||S.dracheMode).toUpperCase();if(DRACHE_MODES.find(x=>x.id===m))S.dracheMode=m;S.isDrache=!S.isDrache;termLog(`DRACHE ${S.isDrache?'FLIEGT 🐉':'LANDET'} ${S.dracheMode} — 44=DRACHE 6fach — ${DRACHE_MODES.find(x=>x.id===m).name}`,'ok');buildDracheUI();initAudio();break;}
  case 'fusion':termLog(`FUSION: PC=Kaiser=Drache zugleich = 55=KAISER=DRACHE = beste wenn 2 Wahrheiten = PQ hält beide = SLI TBH 2 GPUs=1 EINE = 1 Hand von 6 = QUBE 6 Faces = ${S.kaiserMode}+${S.dracheMode} = HAND V103 geopfert 730=FREI→1=HAND`,'ok');termLog(`KaiserPower ${S.kaiserPower}% Drache ${S.dracheMode} → Fusion Score ${(S.kaiserPower+S.out)%100} → BESTE = FUSION selbst`,'ok');S.isKaiser=true;S.isDrache=true;buildKaiserUI();buildDracheUI();break;
  case 'sound':initAudio();S.sound=!S.sound;$('btnSound').textContent=S.sound?'🔊 ON':'🔇 OFF';termLog(`Sound ${S.sound?'ON WebAudio DRACHE 6fach OST WEST PAULI SIEGFRIED VULKAN ACHSE':'OFF'}`,'ok');break;
  case 'clear':termEl.innerHTML='';break;
  default:termLog('unknown '+cmd,'err');
 }
}
$('btnRun').onclick=()=>S.running?stopLoop():startLoop();
$('btnStep').onclick=()=>{if(CPU.halt){termLog('HALT reset','err');return;}stopLoop();step();renderRegs();renderRAM();renderROM();drawGPU();updateStatus();};
$('btnReset').onclick=reset;
$('btnKaiser').onclick=()=>runCmd('kaiser');
$('btnDrache').onclick=()=>runCmd('drache');
$('btnFusion').onclick=()=>runCmd('fusion');
$('btnSound').onclick=()=>runCmd('sound');
$('speed').oninput=e=>{S.speed=parseInt(e.target.value);$('speedLbl').textContent=S.speed+' Hz';if(S.running){stopLoop();startLoop();}};
$('rauch').oninput=e=>{S.rauch=parseInt(e.target.value);$('rauchLbl').textContent=S.rauch+'%';};
setTimeout(resizeGPU,60);
buildDracheUI();buildKaiserUI();
boot();
</script>
</body>
</html>
